rules_version = '2';

// Module 1 (Auth) is now wired up with real FirebaseAuth UIDs, so the
// temporary open test-mode rules are retired. Loosen a specific match
// block if your module needs broader access — don't reopen the whole
// database.
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /live_sessions/{sessionId} {
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.ownerId ||
         request.auth.uid in resource.data.sharedWithUserIds);

      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.ownerId;

      allow update: if request.auth != null &&
        request.auth.uid == resource.data.ownerId;

      allow delete: if false;
    }

    // Default-deny anything not explicitly matched above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
