rules_version = '2';

// Module 1 (Auth) landed with real FirebaseAuth UIDs (email/password
// sign-in, with Module 2's anonymous sessions linked onto the same UID
// rather than orphaned), so the temporary wide-open test-mode rules are
// retired.
// Loosen a specific match block if your module needs broader access —
// don't reopen the whole database.
service cloud.firestore {
  match /databases/{database}/documents {

    // SafeHer Admin (the separate web dashboard, SafeHerAdmin/) is a plain
    // client like the mobile app — there is no service account/backend
    // (Cloud Functions needs the paid Blaze plan, which this project
    // deliberately avoids). Admin access is instead a Firestore-native
    // role check: a signed-in user counts as an admin if — and only if —
    // a document exists at admins/{their uid}. That document is written
    // by hand in the Firebase Console (see SafeHerAdmin/README.md), never
    // by any client, so "who is an admin" can't be granted by the app.
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{uid} {
      // A signed-in user may check only their own admin status (used by
      // SafeHerAdmin's login gate) — never list or read who else is an
      // admin, and never write this from a client.
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow write: if request.auth != null && request.auth.uid == uid;

      // Module 2 — Contacts. Anonymous or email-verified, request.auth.uid
      // is real and stable either way. Deliberately NOT admin-readable —
      // a trusted contact's phone number is the user's own private data,
      // out of scope for what the admin dashboard needs to do its job.
      match /contacts/{contactId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    match /live_sessions/{sessionId} {
      allow read: if isAdmin() || (request.auth != null &&
        (request.auth.uid == resource.data.ownerId ||
         request.auth.uid in resource.data.sharedWithUserIds));

      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.ownerId;

      allow update: if request.auth != null &&
        request.auth.uid == resource.data.ownerId;

      allow delete: if false;
    }

    // Module 9 — Incident Reporting/History/Admin Dashboard. Reporters can
    // read/create their own incidents; SafeHerAdmin reads across all of
    // them via isAdmin() above — same client-side rules, broader match.
    match /incidents/{incidentId} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == resource.data.reporterId);
      allow create: if request.auth != null && request.auth.uid == request.resource.data.reporterId;
      allow update, delete: if false;
    }

    // Module 7 — Evidence recordings live on-device only (see
    // EvidenceService); nothing under `recordings` is ever written to
    // Firestore, so there's no rule for it here.

    // Default-deny anything not explicitly matched above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
