rules_version = '2';

// TEMPORARY test-mode rules — open for demo/testing since Module 1 (Auth)
// is still mocked and no real Firebase Auth UIDs exist yet. Replace with
// the auth-scoped version below before any real user data goes in.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}

