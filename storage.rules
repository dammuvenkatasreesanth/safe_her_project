rules_version = '2';

// Firebase Storage security rules for SafeHer — Module 7 (Evidence
// Recording & Storage). Metadata for each file lives in the `recordings`
// Firestore collection (see EvidenceService); these rules gate the actual
// file bytes, since a Storage download URL alone doesn't enforce access.
service firebase.storage {
  match /b/{bucket}/o {

    // Evidence files: evidence/{uid}/{recordingId}_{fileName}
    // Only the owning user can read or write their own evidence — mirrors
    // the Firestore rule on the `recordings` collection so metadata and
    // file access stay in lockstep.
    match /evidence/{userId}/{fileName} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Server-side backstop on EvidenceService.maxFileSizeBytes — belt
      // and suspenders in case a future client skips the app's own check.
      allow write: if request.resource.size < 50 * 1024 * 1024;
    }

    // Deny everything else by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
